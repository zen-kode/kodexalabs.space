{
  "name": "kodexalabs-sparks",
  "version": "1.0.0",
  "description": "KodexaLabs Sparks - Hybrid Supabase + Firebase + Vercel Application",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > types/supabase.ts",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "firebase:deploy": "firebase deploy --only storage,functions",
    "firebase:emulators": "firebase emulators:start --only storage,functions",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "build:analyze": "ANALYZE=true npm run build",
    "postinstall": "npm run type-check"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@supabase/supabase-js": "^2.38.0",
    "@supabase/auth-helpers-nextjs": "^0.8.0",
    "@supabase/auth-helpers-react": "^0.4.0",
    "firebase": "^10.7.0",
    "firebase-admin": "^11.11.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "jest": "^29.0.0",
    "@testing-library/react": "^13.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@next/bundle-analyzer": "^14.0.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zen-kode/kodexalabs.space.git"
  },
  "keywords": [
    "nextjs",
    "supabase",
    "firebase",
    "vercel",
    "hybrid-architecture",
    "kodexalabs"
  ],
  "author": "KodexaLabs",
  "license": "MIT"
}